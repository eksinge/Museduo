{
  "name": "muse-chat-isolation",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "让 Codex / Claude Code 在 (不同的/一个) 对话中打开不同的 Muse 账号",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/isolation.e2e.mjs",
    "test:e2e:claude": "node tests/isolation.e2e.mjs --host claude",
    "test:accounts": "node tests/accounts.e2e.mjs --installed",
    "test:accounts:claude": "node tests/accounts.e2e.mjs --claude --installed",
    "test:accounts:mixed": "node tests/accounts.e2e.mjs --mixed --installed"
  },
  "dependencies": {
    "@playwright/cli": "0.1.22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eksinge/Museduo.git"
  }
}
